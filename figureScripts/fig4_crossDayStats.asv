function [statSummary] = fig4_crossDayStats(crossDayStats_lobv,crossDayStats_sim2,paperFold,savebool)
% fig4_crossDayStats(crossDayStats_lobv,'lobv',crossDayStats_sim2,'sim2', paperFold, savebool)

%% 
[pLobv, tblLobv, statsLobv] = friedman(crossDayStats_lobv);
cLobv = multcompare(stats,'CType', 'bonferroni');
lobvStats = v2struct(pLobv, tblLobv, statsLobv, cLobv);

[pSim2, tblSim2, statsSim2] = friedman(crossDayStats_sim2);
cSim2 = multcompare(stats,'CType', 'bonferroni');
sim2Stats = v2struct(pSim2, tblSim2, statsSim2, cSim2);

%% Save maybe
saveFold = fullfile(paperFold,'Figures','Fig4','Sub2_CrossDayPredictions');
if ~exist(saveFold,'dir'); mkdir(saveFold); end

if savebool
    save(fullfile(figFold,sprintf('GLM_%s_%s_%s.mat',v1,v2,trialType)),'GLMout');

    